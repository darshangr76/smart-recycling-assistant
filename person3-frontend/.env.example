# ==============================================================================
# SMART RECYCLE AI — Environment Variables Configuration
# Copy this file to .env or .env.local to customize endpoints
# All variables prefixed with VITE_ are exposed to the browser client bundle
# Never put private server secrets here
# ==============================================================================

# External AI Waste Classification Backend Endpoint (Optional)
# If left blank, the application automatically uses high-fidelity simulation presets
# Example: http://localhost:8000 or https://api.smartrecycle.ai
VITE_API_BASE_URL=

# Supabase Authentication & Database Integration (Optional)
# If left blank, the application automatically persists data to browser localStorage
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
